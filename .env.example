# Admin dashboard server settings. Copy to .env.local for local development, and
# set the same names in Vercel → Project → Settings → Environment Variables
# (Production). NEVER commit real values. See docs/SHIKHAR-TECHNICAL-HANDOFF.md.

# Supabase project (sign-in, drafts, publication log). Public values:
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<legacy anon JWT from Supabase → Project Settings → API Keys>

# SECRET — Supabase service role key. Only used by /api/team (invite people,
# create one-time sign-in links, change access). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — fine-grained GitHub token limited to THIS repository with
# "Contents: Read and write" + "Commit statuses: Read-only". Used to publish.
GITHUB_TOKEN=
GITHUB_REPO=shikharsisodia7/stem-with-ashley
GITHUB_BRANCH=master

# Public site the dashboard verifies publishes against.
PUBLIC_SITE_URL=https://stem-with-ashley.vercel.app

# SECRET — any long random string; Vercel sends it to the daily keep-alive cron.
CRON_SECRET=

# Local automated browser tests only (tests/e2e). Never set these in Vercel.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_NOROLE_EMAIL=
E2E_NOROLE_PASSWORD=
ADMIN_OWNER_EMAIL=
ASHLEY_EMAIL=
